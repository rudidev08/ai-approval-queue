#!/usr/bin/python3
# One-glance status of the assistant stack on this Mac: host resources,
# services, hermes cron jobs, and backup freshness, checked against
# manifest.json (the expected list — anything missing from the live system
# is flagged). Text by default, --json for machines. Runs on the system
# python, stdlib only.

import json
import os
import plistlib
import re
import socket
import sqlite3
import subprocess
import sys
import urllib.request
from datetime import datetime
from urllib.parse import urlsplit

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "services", "mcp", "common"))
import hermes_env  # noqa: E402

JOBS_FILE = os.path.expanduser("~/.hermes/cron/jobs.json")
EXECUTIONS = os.path.expanduser("~/.hermes/cron/executions.db")
CMD_TIMEOUT = 10
HTTP_TIMEOUT = 4
OVERDUE_GRACE_MIN = 15
LOOPBACK = ("127.0.0.1", "localhost", "::1")

NOW = datetime.now().astimezone()


def _run(*cmd):
    return subprocess.run(list(cmd), capture_output=True, text=True,
                          timeout=CMD_TIMEOUT).stdout


# ---- host metrics (each returns a display string; "?" if a parser breaks) --

def _cpu():
    # two samples; the first is a since-boot average, so read the second
    lines = [l for l in _run("top", "-l", "2", "-n", "0").splitlines()
             if "CPU usage" in l]
    idle = float(re.search(r"([\d.]+)%\s*idle", lines[-1]).group(1))
    return round(100 - idle, 1)


def _gpu():
    out = _run("ioreg", "-r", "-d", "1", "-w", "0", "-c", "IOAccelerator")
    vals = [int(v) for v in re.findall(r'"Device Utilization %"=(\d+)', out)]
    return round(sum(vals) / len(vals), 1)


def _ram():
    # match the menu-bar app: used = active + wired + compressed
    out = _run("vm_stat")
    pagesize = int(re.search(r"page size of (\d+) bytes", out).group(1))

    def pages(label):
        return int(re.search(r"%s:\s+(\d+)\." % label, out).group(1))

    used = (pages("Pages active") + pages("Pages wired down")
            + pages("Pages occupied by compressor")) * pagesize
    total = int(_run("sysctl", "-n", "hw.memsize"))
    return round(used / total * 100, 1)


_PRESSURE = {"1": "normal", "2": "warning", "4": "critical"}


def _pressure():
    lvl = _run("sysctl", "-n", "kern.memorystatus_vm_pressure_level").strip()
    return _PRESSURE.get(lvl, "level %s" % lvl)


def _disk_free():
    s = os.statvfs("/")
    free = s.f_bavail * s.f_frsize
    if free >= 1e12:
        return "%.1f TB free" % (free / 1e12)
    return "%.0f GB free" % (free / 1e9)


def _host():
    vals = {}
    for key, fn in (("cpu", _cpu), ("gpu", _gpu), ("ram", _ram),
                    ("pressure", _pressure), ("disk", _disk_free)):
        try:
            vals[key] = fn()
        except Exception:
            vals[key] = "?"
    return vals


# ---- humanized durations ---------------------------------------------------

def _age(seconds):
    if seconds < 90:
        return "%.0fs" % seconds
    if seconds < 90 * 60:
        return "%.0fm" % (seconds / 60)
    if seconds < 36 * 3600:
        return "%.0fh" % (seconds / 3600)
    return "%.0fd" % (seconds / 86400)


def _uptime(etime):
    # ps etime: [[dd-]hh:]mm:ss
    m = re.match(r"(?:(?:(\d+)-)?(\d+):)?(\d+):(\d+)", etime.strip())
    d, h, mi = int(m.group(1) or 0), int(m.group(2) or 0), int(m.group(3))
    if d:
        return "%dd %dh" % (d, h)
    if h:
        return "%dh %dm" % (h, mi)
    return "%dm" % mi


def _sched(expr):
    # "0 6 * * *" -> "06:00", "0 2 * * 1" -> "Mon 02:00",
    # "23 */8 * * *" -> "every 8h at :23"; anything else raw
    parts = expr.split()
    if len(parts) != 5:
        return expr
    m, h, dom, mon, dow = parts
    if m.isdigit() and re.fullmatch(r"\*/\d+", h) and dom == mon == dow == "*":
        return "every %sh at :%02d" % (h[2:], int(m))
    if not (m.isdigit() and h.isdigit()):
        return expr
    hhmm = "%02d:%02d" % (int(h), int(m))
    if dom == "*" and mon == "*" and dow == "*":
        return hhmm
    days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    if dom == "*" and mon == "*" and dow.isdigit():
        return "%s %s" % (days[int(dow)], hhmm)
    return expr


def _ago(iso):
    return _age((NOW - datetime.fromisoformat(iso)).total_seconds())


# ---- checks ----------------------------------------------------------------

def _launchd_table():
    table = {}
    for line in _run("launchctl", "list").splitlines()[1:]:
        cols = line.split("\t")
        if len(cols) == 3:
            table[cols[2]] = (cols[0], cols[1])  # (pid or "-", last exit)
    return table


def _http(url):
    # any response means the server is alive; >=500 counts as a problem
    try:
        with urllib.request.urlopen(url, timeout=HTTP_TIMEOUT) as r:
            return r.status, None
    except urllib.error.HTTPError as e:
        return e.code, None
    except Exception as e:
        return None, str(getattr(e, "reason", e))


def _last_restart(log):
    # a restart watcher's log: one line per restart, local timestamp first
    try:
        with open(os.path.expanduser(log)) as f:
            lines = [l for l in f if " restarted webui: " in l]
    except OSError:
        lines = []
    if not lines:
        return "no restarts yet"
    ts = datetime.strptime(lines[-1][:19], "%Y-%m-%d %H:%M:%S").astimezone()
    return "last %s" % _age((NOW - ts).total_seconds())


# ---- where the callers keep a shared server's address --------------------

def _yaml_path(path, key):
    # hermes writes config.yaml as a plain nested mapping with two-space
    # indents: walk the keys by indent, split each line on its first colon
    # (a URL value keeps its "://"), drop quotes and a trailing comment
    want = key.split(".")
    stack = []  # (indent, key) of the mapping keys above the current line
    with open(path, encoding="utf-8") as f:
        for line in f:
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            indent = len(line) - len(line.lstrip())
            k, sep, v = line.strip().partition(":")
            if not sep:
                continue
            while stack and stack[-1][0] >= indent:
                stack.pop()
            stack.append((indent, k))
            if [s[1] for s in stack] == want:
                return v.split(" #")[0].strip().strip('"').strip("'")
    raise KeyError(key)


def _sh_export(path, key):
    with open(path, encoding="utf-8") as f:
        for line in f:
            m = re.match(r'\s*export\s+%s=["\']?([^"\'\s]+)' % re.escape(key),
                         line)
            if m:
                return m.group(1)
    raise KeyError(key)


def _caller_value(caller):
    # the reader follows the file ending; .json and .plist share the dotted
    # key path walk over the loaded mapping
    path = os.path.expanduser(caller["file"])
    key = caller["key"]
    if path.endswith(".yaml"):
        return _yaml_path(path, key)
    if path.endswith(".sh"):
        return _sh_export(path, key)
    with open(path, "rb") as f:
        data = plistlib.load(f) if path.endswith(".plist") else json.load(f)
    for part in key.split("."):
        data = data[part]
    return data


def _addresses(item):
    """{scheme://host:port: [caller file names]} across the item's callers,
    plus one note per caller whose file or key could not be read. The path
    of a stored URL (/v1) is dropped: the health path is probed at the root."""
    found, unreadable = {}, []
    for c in item["callers"]:
        try:
            u = urlsplit(_caller_value(c))
            if not u.scheme or not u.netloc:
                raise ValueError("not a URL")
        except (OSError, KeyError, TypeError, ValueError) as e:
            unreadable.append("cannot read %s from %s (%s)"
                              % (c["key"], os.path.basename(c["file"]), e))
            continue
        # every loopback spelling is one server: dedup on 127.0.0.1
        host = "127.0.0.1" if u.hostname in LOOPBACK else u.hostname
        port = ":%d" % u.port if u.port else ""
        found.setdefault("%s://%s%s" % (u.scheme, host, port), []).append(
            os.path.basename(c["file"]))
    return found, unreadable


def _check_status_file(item, parts, bad):
    # The pid is checked against the process table, so a status file left
    # behind by a dead process still reads as not running.
    try:
        with open(os.path.expanduser(item["status_file"])) as f:
            st = json.load(f)
    except (OSError, ValueError) as e:
        bad.append("status file unreadable (%s)" % e)
        return
    pid = str(st.get("pid", ""))
    if not pid or not _run("ps", "-o", "pid=", "-p", pid).strip():
        bad.append("not running (pid %s)" % (pid or "none"))
        return
    parts.append("up %s" % _uptime(_run("ps", "-o", "etime=", "-p", pid)))
    if st.get("status") != "connected":
        bad.append("status %s" % st.get("status"))
    parts.append("v%s" % st.get("version", "?"))


def _check_socket(item, parts, bad):
    # A server that detaches from the launchd job that starts it: alive when
    # its unix socket accepts a connection.
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    try:
        s.connect(os.path.expanduser(item["socket"]))
        parts.append("socket answers")
    except OSError as e:
        bad.append("server not answering (%s)" % e)
    finally:
        s.close()


def _check_service(item, launchd, problems, address=None, callers=None,
                   notes=()):
    """One row. A fixed row probes item["http"]. A shared-server row probes
    item["health"] at one address its callers name; the launchd check runs
    only when that address is loopback, because a remote process has no
    launchd job on this Mac. notes are the unreadable-caller notes."""
    parts, bad = [], []
    if address:
        parts.append(urlsplit(address).netloc)
        if callers:
            parts.append("used by " + ", ".join(callers))
    local = address is None or urlsplit(address).hostname in LOOPBACK
    bad.extend(notes)
    if "launchd" in item and local:
        pid, exit_st = launchd.get(item["launchd"], (None, None))
        if pid is None:
            bad.append("not loaded in launchd")
        elif "socket" in item:
            pass  # the job only starts the server, which then detaches
        elif "status_file" in item:
            # the launchd job is only the watchdog that restarts the daemon,
            # so it is idle between runs; the daemon is checked on its own
            if pid == "-" and exit_st != "0":
                bad.append("watchdog last run failed (exit %s)" % exit_st)
        elif item.get("event"):
            # short-lived WatchPaths job: idle is its normal state, so only
            # the last completed restart is reported
            if pid == "-" and exit_st != "0":
                bad.append("last run failed (exit %s)" % exit_st)
            parts.append(_last_restart(item["restart_log"]))
        elif pid == "-":
            bad.append("loaded, not running (last exit %s)" % exit_st)
        else:
            up = _uptime(_run("ps", "-o", "etime=", "-p", pid))
            parts.append("up %s" % up)
    if "status_file" in item:
        _check_status_file(item, parts, bad)
    if "socket" in item:
        _check_socket(item, parts, bad)
    url = address + item["health"] if address else item.get("http")
    if url:
        code, err = _http(url)
        if code is None:
            bad.append("http failed (%s)" % err)
        elif code >= 500:
            bad.append("http %d" % code)
        else:
            parts.append("http %d" % code)
    state = "!!" if bad else "ok"
    for b in bad:
        problems.append("%s: %s" % (item["name"], b))
    return state, " · ".join(bad + parts)


def _listening(port):
    """A loopback connect: a closed port refuses at once, so this never hangs."""
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0


def _check_servers(item, problems):
    """One row per MCP server the item's app runs, from its child list
    (item["servers"]). Only the name and port are read: the file also holds
    API keys. An unreadable list is one flagged row."""
    try:
        with open(os.path.expanduser(item["servers"])) as f:
            entries = json.load(f)["servers"]
    except (OSError, ValueError, KeyError) as e:
        note = "server list unreadable (%s)" % e
        problems.append("%s: %s" % (item["name"], note))
        return [(item["name"] + " servers", "!!", note, None)]
    rows = []
    for e in entries:
        address = "http://127.0.0.1:%d" % e["port"]
        if _listening(e["port"]):
            rows.append((e["name"], "ok", "listening", address))
        else:
            problems.append("%s: not listening on :%d" % (e["name"], e["port"]))
            rows.append((e["name"], "!!", "not listening", address))
    return rows


def _check_shared(item, launchd, problems):
    """The rows of a shared server: one per distinct address its callers
    name. With no readable address there is still one row, flagged, so the
    server never drops off the report."""
    found, notes = _addresses(item)
    if not found:
        # nothing to probe and no launchd job to assume: the notes are the row
        notes.append("no caller names an address")
        problems.extend("%s: %s" % (item["name"], n) for n in notes)
        return [("!!", " · ".join(notes), None)]
    rows = []
    for address, callers in found.items():
        state, detail = _check_service(
            item, launchd, problems, address,
            callers if len(found) > 1 else None, notes)
        rows.append((state, detail, address))
    return rows



def _newest_files(item, has_run, problems):
    # one job can write several backup files; each is checked on its own so a
    # single stale or missing one is named rather than hidden behind the others
    paths = item["newest_files"]
    ages, missing, stale = [], [], 0
    for p in paths:
        try:
            mtime = os.path.getmtime(os.path.expanduser(p))
        except OSError:
            missing.append(p)
            continue
        age_s = (NOW - datetime.fromtimestamp(mtime).astimezone()
                 ).total_seconds()
        ages.append(age_s)
        if has_run and age_s > item["max_file_age_h"] * 3600:
            stale += 1
            problems.append("%s: %s is %s old" % (item["name"], p, _age(age_s)))
    if not ages:
        # every file absent: a fresh machine before the job's first run here
        if has_run:
            problems.append("%s: first backup not run" % item["name"])
        return "first backup not run", has_run
    if has_run:
        for p in missing:
            problems.append("%s: backup file missing (%s)" % (item["name"], p))
    parts = ["%d files" % len(paths)]
    if missing:
        parts.append("%d missing" % len(missing))
    parts.append("oldest %s ago" % _age(max(ages)))
    return ", ".join(parts), bool(has_run and (missing or stale))


def _running_job_ids():
    """Job ids whose newest attempt in hermes' executions ledger is still
    claimed/running. Any read problem -> empty set, so the checks run as if
    nothing were running."""
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % EXECUTIONS, uri=True,
                               timeout=1)
        try:
            rows = conn.execute(
                "SELECT job_id, status FROM executions "
                "ORDER BY claimed_at DESC, id DESC").fetchall()
        finally:
            conn.close()
    except sqlite3.Error:
        return set()
    newest = {}
    for job_id, status in rows:
        newest.setdefault(job_id, status)
    return {j for j, s in newest.items() if s in ("claimed", "running")}


def _check_cron(item, jobs, running, problems):
    job = jobs.get(item["name"])
    if job is None:
        problems.append("%s: in manifest, not in hermes cron" % item["name"])
        return "!!", "missing — in manifest, not in hermes cron"
    parts, bad = [], []
    parts.append(_sched(job.get("schedule_display") or "?"))
    has_run = job.get("last_run_at") is not None
    if not job.get("enabled", False):
        bad.append("disabled")
    elif job.get("last_status") not in (None, "ok"):
        err = (job.get("last_error") or job.get("last_status") or "")[:80]
        bad.append("failed %s ago: %s" % (_ago(job["last_run_at"]), err))
    elif job.get("next_run_at"):
        late = (NOW - datetime.fromisoformat(job["next_run_at"])
                ).total_seconds()
        if late > OVERDUE_GRACE_MIN * 60:
            bad.append("overdue — was due %s ago" % _age(late))
    if not bad:
        parts.append("ok %s ago" % _ago(job["last_run_at"]) if has_run
                     else "never ran")
    file_stale = False
    if "newest_files" in item:
        # mid-run the job deletes and rewrites its files, so checking them
        # now would flag missing/stale files that are simply being written
        if job.get("id") in running:
            parts.append("run in progress")
        else:
            note, file_stale = _newest_files(item, has_run, problems)
            parts.append(note)
    for b in bad:
        problems.append("%s: %s" % (item["name"], b))
    state = "!!" if bad or file_stale else ("ok" if has_run else "--")
    return state, " · ".join([parts[0]] + bad + parts[1:])


# ---- assemble --------------------------------------------------------------

def collect():
    with open(os.path.join(HERE, "manifest.json")) as f:
        manifest = json.load(f)
    try:
        with open(JOBS_FILE) as f:
            jobs = {j["name"]: j for j in json.load(f)["jobs"]}
    except OSError:
        jobs = {}
    launchd = _launchd_table()
    running = _running_job_ids()
    problems = []
    categories = []
    manifest_cron_names = set()
    for cat in manifest["categories"]:
        rows = []
        for item in cat["items"]:
            kind = item["type"]
            if kind == "service" and "callers" in item:
                checked = _check_shared(item, launchd, problems)
            elif kind == "service":
                u = urlsplit(item.get("http", ""))
                address = "%s://%s" % (u.scheme, u.netloc) if u.netloc else None
                checked = [(*_check_service(item, launchd, problems), address)]
            else:
                manifest_cron_names.add(item["name"])
                checked = [(*_check_cron(item, jobs, running, problems), None)]
            for state, detail, address in checked:
                rows.append({"name": item["name"], "desc": item["desc"],
                             "kind": kind, "state": state, "detail": detail,
                             "address": address})
            if "servers" in item:
                for name, state, detail, address in _check_servers(item, problems):
                    rows.append({"name": name, "desc": "MCP server in " + item["name"],
                                 "kind": "mcp", "state": state, "detail": detail,
                                 "address": address})
        categories.append({"name": cat["name"], "items": rows})
    unlisted = [n for n in jobs if n not in manifest_cron_names]
    if unlisted:
        rows = []
        for n in sorted(unlisted):
            problems.append("%s: cron job not in manifest" % n)
            rows.append({"name": n, "desc": "", "kind": "cron", "state": "!!",
                         "detail": "cron job not in manifest — add it",
                         "address": None})
        categories.append({"name": "unlisted", "items": rows})
    return {
        "generated": NOW.isoformat(timespec="seconds"),
        "ok": not problems,
        "problems": problems,
        "host": _host(),
        "categories": categories,
    }


def render(status):
    verdict = ("OK" if status["ok"]
               else "%d problem%s" % (len(status["problems"]),
                                      "s" if len(status["problems"]) > 1 else ""))
    h = status["host"]
    out = [
        "assistant status · %s · %s" % (verdict, NOW.strftime("%Y-%m-%d %H:%M")),
        "",
        "host   CPU %s%%  GPU %s%%  RAM %s%% (%s)  disk %s"
        % (h["cpu"], h["gpu"], h["ram"], h["pressure"], h["disk"]),
    ]
    width = max(len(r["name"]) for c in status["categories"]
                for r in c["items"])
    for cat in status["categories"]:
        out.append("")
        out.append(cat["name"])
        for r in cat["items"]:
            out.append("  %s  %s  %s  %s" % (r["state"],
                                             r["name"].ljust(width),
                                             r["kind"].ljust(9), r["detail"]))
    return "\n".join(out)


def main():
    status = collect()
    if "--json" in sys.argv[1:]:
        print(json.dumps(status, indent=1))
    else:
        print(render(status))
    sys.exit(0 if status["ok"] else 1)


if __name__ == "__main__":
    main()
